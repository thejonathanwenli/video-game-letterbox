# Copy to the repository root as .env on the AWS server. Never commit .env.
# Set SITE_DOMAIN to a domain whose DNS points to the server's public IP.
SITE_DOMAIN=your-domain.example
MYSQL_ROOT_PASSWORD=replace-with-a-unique-strong-root-password
DB_USERNAME=letterbox_app
DB_PASSWORD=replace-with-a-unique-strong-app-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
IGDB_CLIENT_ID=replace-with-your-igdb-client-id
IGDB_CLIENT_SECRET=replace-with-your-igdb-client-secret
